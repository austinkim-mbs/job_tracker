# Copy this file to .env and fill in your values

# --- Required ---

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

ANTHROPIC_API_KEY=sk-ant-...
SHEET_ID=your-google-sheet-id

# Django (generate your own: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True

# Path to your resume PDF (defaults to ../Resume v12 (1).pdf if not set)
# Use forward slashes or double backslashes on Windows
RESUME_PATH=C:/Users/YourName/Documents/resume.pdf

# --- Optional ---
# Classifier backend: "claude" (default) or "ollama" (local model)
CLASSIFIER_BACKEND=claude

# Ollama settings — only needed if CLASSIFIER_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
